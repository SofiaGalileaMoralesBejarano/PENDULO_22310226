// --- Definición de Pines ---
const int ENA = 25;       // Pin PWM para el L298N
const int IN1 = 26;       // Dirección 1
const int IN2 = 27;       // Dirección 2
const int encoderPinA = 32; // Encoder (Canal A)

// --- Selector de Perfil (1 al 9 según la guía de tu profesor) ---
int tipoPerfil = 8; // Cambia este número del 1 al 9 para probar cada función

volatile long encoderCount = 0;
void IRAM_ATTR countEncoder() {
  encoderCount++;
}

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(encoderPinA, INPUT_PULLUP);
  
  attachInterrupt(digitalPinToInterrupt(encoderPinA), countEncoder, RISING);
  Serial.begin(115200);

  // Dirección fija de giro hacia adelante
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
}

void loop() {
  // Tiempo en segundos desde el inicio
  float t = millis() / 1000.0; 
  float pwmOutput = 0;

  switch (tipoPerfil) {
    
    // 1. Constante: p(t) = p0
    case 1: {
      float p0 = 120; // Velocidad fija
      pwmOutput = p0;
      break;
    }

    // 2. Rampa lineal: p(t) = p0 + at
    case 2: {
      float p0 = 0;
      float a = 20; // aceleración (pasos/s^2 o tasa de incremento)
      pwmOutput = p0 + (a * fmod(t, 15.0)); // Se reinicia cada 15s
      break;
    }

    // 3. Perfil trapezoidal: Aceleración, constante y desaceleración
    case 3: {
      float ciclo = fmod(t, 12.0); // Ciclo de 12 segundos
      if (ciclo < 3.0) pwmOutput = ciclo * 80;          // Aceleración
      else if (ciclo < 9.0) pwmOutput = 240;            // Constante
      else pwmOutput = 240 - ((ciclo - 9.0) * 80);      // Desaceleración
      break;
    }

    // 4. Senoidal: p(t) = p0 + A * sin(2*pi*fm*t + phi)
    case 4: {
      float p0 = 125;
      float A = 100;
      float fm = 0.2; // Frecuencia de modulación (Hz)
      pwmOutput = p0 + A * sin(2 * 3.14159 * fm * t);
      break;
    }

    // 5. Escalonada (Onda cuadrada): Alterna entre p1 y p2
    case 5: {
      float T = 6.0; // Periodo de 6 segundos
      if (fmod(t, T) < (T / 2.0)) {
        pwmOutput = 60;  // p1
      } else {
        pwmOutput = 220; // p2
      }
      break;
    }

    // 6. Exponencial creciente: p(t) = p0 * (1 + alpha * t)^k
    case 6: {
      float p0 = 20;
      float alpha = 0.5;
      float k = 1.2;
      float t_mod = fmod(t, 10.0);
      pwmOutput = p0 * pow((1.0 + alpha * t_mod), k);
      break;
    }

    // 7. Perfil Gaussiano: Pulso de velocidad localizado
    case 7: {
      float A = 250;
      float t0 = 5.0;  // Centro del pulso en segundos
      float sigma = 1.5; // Ancho del pulso
      float t_mod = fmod(t, 10.0);
      pwmOutput = A * exp(-pow((t_mod - t0) / sigma, 2));
      break;
    }

    // 8. Diente de sierra: p(t) = A * (t/T mod 1)
    case 8: {
      float A = 255;
      float T = 5.0; // Periodo de 5 segundos
      pwmOutput = A * fmod(t / T, 1.0);
      break;
    }

    // 9. Modulación por ruido blanco: p(t) = p0 + epsilon(t)
    case 9: {
      float p0 = 128;
      float A = 50; // Amplitud del ruido aleatorio
      float epsilon = random(-A, A);
      pwmOutput = p0 + epsilon;
      delay(100); // Pausa para que el ruido no sature la ejecución
      break;
    }
  }

  // Asegurar que el valor PWM esté siempre entre 0 y 255
  pwmOutput = constrain(pwmOutput, 0, 255);
  analogWrite(ENA, (int)pwmOutput);

  // Lectura del encoder
  noInterrupts();
  long currentPulses = encoderCount;
  interrupts();

  // Impresión en formato compatible con el Serial Plotter (Herramientas > Plotter Serial)
  Serial.print("Perfil:");
  Serial.print(tipoPerfil);
  Serial.print(",PWM:");
  Serial.print(pwmOutput);
  Serial.print(",Pulsos:");
  Serial.println(currentPulses);

  delay(20);
}
